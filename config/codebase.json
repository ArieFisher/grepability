{
	"repository": "https://github.com/sindresorhus/ky.git",
	"commit": "3541888878c4d303a8bc2ad61815f4e048f55a5d",
	"corpus": {
		"directory": "source",
		"extension": ".ts"
	},
	"install": ["npm", "install", "--ignore-scripts", "--no-audit", "--no-fund"],
	"compile": ["npm", "run", "build"],
	"typecheck": [
		["npx", "tsc", "--project", "tsconfig.json", "--noEmit"],
		["npx", "tsc", "--project", "tsconfig.test.json", "--noEmit"]
	],
	"verificationSuite": {
		"directory": "test",
		"extension": ".ts",
		"skip": ["browser.ts"],
		"command": ["npx", "ava", "--tap", "--timeout=60s"],
		"reexecution": ["npx", "ava", "--tap", "--timeout=60s", "{file}", "--match", "{name}"],
		"verificationTitleSeparator": " › ",
		"declaration": "^\\s*test(?:\\.serial)?\\((?<quote>['\"`])(?<title>(?:\\\\.|(?!\\k<quote>)[^\\\\])*)\\k<quote>"
	}
}
